# ═══════════════════════════════════════════════════════
# TeacherLicence — Environment Variables
# Copy to .env and fill in production values
# ═══════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ───
DB_USERNAME=postgres
DB_PASSWORD=changeme_strong_password
DB_NAME=teacher_licence
DB_PORT=5432

# ─── JWT ───
JWT_SECRET=change-this-to-a-random-256-bit-key-minimum-32-characters-long

# ─── Mistral AI ───
AI_ENABLED=true
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_CLIENT_SERVER_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-medium-latest

# ─── AI RAG (семантичний пошук через pgvector) ───
# Потрібен PostgreSQL з pgvector extension (надається образом pgvector/pgvector:pg16 в docker-compose).
# Якщо вимкнути — семантичний пошук недоступний, інші AI-функції працюватимуть.
AI_RAG_ENABLED=true
# Embedding-модель Mistral (1024-dim). Стандарт — mistral-embed.
MISTRAL_EMBED_MODEL=mistral-embed
# Чи дозволяти Spring AI автоматично створювати таблицю vector_store та HNSW-індекс.
# Потребує CREATE-прав у БД. Якщо юзер НЕ власник схеми — встанови false і створи таблицю вручну.
PGVECTOR_INIT_SCHEMA=true
# Інтервал повної реіндексації (мс). Default 5 хв. Після bulk import можна запустити вручну:
# POST /api/ai/reindex (ADMIN).
AI_RAG_REINDEX_MS=300000

# ─── Scopus API (publication verification) ───
SCOPUS_API_ENABLED=false
SCOPUS_API_KEY=your-scopus-api-key

# ─── Google Drive (file storage) ───
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id
# Mount credentials JSON at /app/config/google-credentials.json
GOOGLE_DRIVE_CREDENTIALS=/app/config/google-credentials.json

# ─── Keycloak SSO ───
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=https://auth.viti.edu.ua
KEYCLOAK_REALM=grade-book
CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# ─── Backend ───
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# ─── DOCX templates ───
DOCX_TEMPLATES_DIR=/app/templates
